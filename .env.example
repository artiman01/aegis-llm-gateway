# ==============================================================================
# AegisLLM Gateway Environment Configuration Template
# ==============================================================================

# Server Network Settings
PORT=7860
HOST=0.0.0.0
WORKERS=2

# Mode: Set to "true" to force MockProvider operation without real upstream API keys
DEMO_MODE=true

# Upstream Provider API Keys (Leave empty to trigger DEMO_MODE fallback automatically)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=30.0

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_TIMEOUT=30.0

# Distributed L1 Cache (Leave empty to use high-performance In-Memory cache)
REDIS_URL=redis://localhost:6379/0

# Caching Thresholds & TTL
L1_CACHE_TTL_SECONDS=3600
L2_CACHE_TTL_SECONDS=86400
L2_SIMILARITY_THRESHOLD=0.90

# FastEmbed ONNX Local Model
FASTEMBED_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
FASTEMBED_CACHE_PATH=./.fastembed_cache

# Circuit Breaker Defaults
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_TIMEOUT_SECONDS=30.0
CB_HALF_OPEN_SUCCESS_THRESHOLD=2
CB_HALF_OPEN_MAX_TRIALS=3
